demo/.venv/
demo/assets/
# demo/out: keep the comparison videos and measurements, ignore the rest
demo/out/*
!demo/out/*.mp4
!demo/out/measurements.json
# clangd index (built from NVIDIA SDK headers) and Python bytecode
.cache/
__pycache__/
