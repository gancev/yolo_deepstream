# Fetched by bootstrap.sh (NVIDIA SDK/EULA material, not redistributed here)
third_party/yolo_deepstream/
third_party/deepstream-includes/
third_party/cuda-includes/
# Build outputs
build/
docker-pull.log
# LOCI machine-local state is handled by .loci/.gitignore (written by loci init)
third_party/tensorrt-includes/
third_party/_debs/
